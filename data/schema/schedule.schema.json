{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theve.local/schema/schedule.schema.json",
  "title": "Theve schedule source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "slots"],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "channelId",
          "catalogItemId",
          "order",
          "plannedDurationSeconds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "channelId": {
            "type": "string",
            "minLength": 1
          },
          "catalogItemId": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "plannedDurationSeconds": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}

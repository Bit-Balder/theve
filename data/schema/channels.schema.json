{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theve.local/schema/channels.schema.json",
  "title": "Theve channels",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "channels"],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "channels": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "number",
          "name",
          "kind",
          "audience",
          "signOffAt",
          "profile",
          "theme",
          "logo"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "const": "video"
          },
          "audience": {
            "enum": ["children", "family", "general", "adult"]
          },
          "signOffAt": {
            "type": ["string", "null"],
            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "profile": {
            "type": "string",
            "minLength": 1
          },
          "theme": {
            "enum": ["yellow", "coral", "cream"]
          },
          "logo": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fullColor", "cream", "black", "compact", "viewBox"],
            "properties": {
              "fullColor": {
                "type": "string",
                "pattern": "^assets/logos/[a-z0-9-]+\\.svg$"
              },
              "cream": {
                "type": "string",
                "pattern": "^assets/logos/[a-z0-9-]+-cream\\.svg$"
              },
              "black": {
                "type": "string",
                "pattern": "^assets/logos/[a-z0-9-]+-black\\.svg$"
              },
              "compact": {
                "type": "string",
                "pattern": "^assets/logos/[a-z0-9-]+-bug\\.svg$"
              },
              "viewBox": {
                "const": "0 0 320 96"
              }
            }
          }
        }
      }
    }
  }
}

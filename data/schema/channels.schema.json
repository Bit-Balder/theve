{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theve.local/schema/channels.schema.json",
  "title": "Theve channels",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "channels"],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "channels": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "number", "name", "kind", "audience", "signOffAt"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "number": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["info", "video"]
          },
          "audience": {
            "enum": ["children", "family", "general"]
          },
          "signOffAt": {
            "type": ["string", "null"],
            "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theve.local/schema/rights.schema.json",
  "title": "Theve rights journal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "entries": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "catalogItemId",
          "status",
          "basis",
          "evidenceUrl",
          "reviewedAt",
          "publicationAllowed",
          "notes"
        ],
        "properties": {
          "catalogItemId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["approved", "review_required", "rejected"]
          },
          "basis": {
            "type": "string",
            "minLength": 1
          },
          "evidenceUrl": {
            "type": ["string", "null"]
          },
          "reviewedAt": {
            "type": ["string", "null"],
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "publicationAllowed": {
            "type": "boolean"
          },
          "licenseUrl": {
            "type": ["string", "null"],
            "format": "uri"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}

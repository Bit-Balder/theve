{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theve.local/schema/weather.schema.json",
  "title": "Theve weather snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "source",
    "fetchedAt",
    "validUntil",
    "locations"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "dataset",
        "license",
        "licenseUrl",
        "termsUrl",
        "attribution",
        "modificationNotice"
      ],
      "properties": {
        "name": { "const": "SMHI" },
        "dataset": { "const": "SNOW1G" },
        "license": { "const": "CC BY 4.0" },
        "licenseUrl": { "type": "string", "format": "uri" },
        "termsUrl": { "type": "string", "format": "uri" },
        "attribution": { "type": "string", "minLength": 1 },
        "modificationNotice": { "type": "string", "minLength": 1 }
      }
    },
    "fetchedAt": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "longitude",
          "latitude",
          "sourceUrl",
          "forecasts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": { "type": "string", "minLength": 1 },
          "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
          "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
          "sourceUrl": { "type": "string", "format": "uri" },
          "forecasts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "validAt",
                "temperatureC",
                "windMps",
                "precipitationMm",
                "symbolCode"
              ],
              "properties": {
                "validAt": { "type": "string", "format": "date-time" },
                "temperatureC": { "type": "number" },
                "windMps": { "type": "number", "minimum": 0 },
                "precipitationMm": { "type": "number", "minimum": 0 },
                "symbolCode": { "type": "integer", "minimum": 1, "maximum": 27 }
              }
            }
          }
        }
      }
    }
  }
}
